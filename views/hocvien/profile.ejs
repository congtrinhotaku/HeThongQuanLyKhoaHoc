<div class="container py-4">
    <div class="row g-4">
        <!-- Cột bên trái: Ảnh đại diện và thông tin chính -->
        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <img src="<%= hv?.anhDaiDien || '/images/default-avatar.png' %>" alt="Ảnh đại diện"
                        class="rounded-circle img-fluid mb-3" style="width: 150px; height: 150px; object-fit: cover;">
                    <h4 class="my-3"><%= hv?.hoTen || 'Chưa cập nhật' %></h4>
                    <p class="text-muted mb-1"><i class="bi bi-envelope-fill me-2"></i><%= hv?.email || 'N/A' %></p>
                    <p class="text-muted mb-4"><i class="bi bi-geo-alt-fill me-2"></i><%= hv?.diaChi || 'Chưa có địa chỉ' %></p>
                </div>
            </div>
        </div>

        <!-- Cột bên phải: Thông tin chi tiết -->
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="card-title mb-0">Thông tin chi tiết</h5>
                        <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#editHocVien">
                            <i class="bi bi-pencil-square me-1"></i> Chỉnh sửa
                        </button>
                    </div>
                    <hr>
                    <dl class="row">
                        <dt class="col-sm-4"><i class="bi bi-person-badge me-2 text-primary"></i>Họ và tên</dt>
                        <dd class="col-sm-8"><%= hv?.hoTen || 'Chưa cập nhật' %></dd>

                        <dt class="col-sm-4"><i class="bi bi-calendar-event me-2 text-primary"></i>Ngày sinh</dt>
                        <dd class="col-sm-8"><%= hv?.ngaySinh ? new Date(hv.ngaySinh).toLocaleDateString('vi-VN') : 'Chưa cập nhật' %></dd>

                        <dt class="col-sm-4"><i class="bi bi-gender-ambiguous me-2 text-primary"></i>Giới tính</dt>
                        <dd class="col-sm-8"><%= hv?.gioiTinh || 'Chưa cập nhật' %></dd>
                    </dl>
                    <hr>
                    <h6 class="text-muted">Thông tin liên hệ</h6>
                    <dl class="row mt-3">
                        <dt class="col-sm-4"><i class="bi bi-telephone-fill me-2 text-primary"></i>Số điện thoại</dt>
                        <dd class="col-sm-8"><%= hv?.soDienThoai || 'Chưa cập nhật' %></dd>

                        <dt class="col-sm-4"><i class="bi bi-chat-dots-fill me-2 text-primary"></i>Số Zalo</dt>
                        <dd class="col-sm-8"><%= hv?.soZalo || 'Chưa cập nhật' %></dd>

                        <dt class="col-sm-4"><i class="bi bi-envelope-fill me-2 text-primary"></i>Email</dt>
                        <dd class="col-sm-8"><%= hv?.email || 'Chưa cập nhật' %></dd>

                        <dt class="col-sm-4"><i class="bi bi-geo-alt-fill me-2 text-primary"></i>Địa chỉ</dt>
                        <dd class="col-sm-8"><%= hv?.diaChi || 'Chưa cập nhật' %></dd>
                    </dl>
                </div>
            </div>
        </div>

        <!-- Các khóa học đã đăng ký -->
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title mb-3"><i class="bi bi-journal-check me-2"></i>Các khóa học đã đăng ký</h5>
                    <% if (dsDangKy && dsDangKy.length > 0) { %>
                        <div class="list-group">
                            <% dsDangKy.forEach(dk => { %>
                                <% if (dk.khoaHoc) { %>
                                    <a href="/hocvien/khoahoc/<%= dk.khoaHoc._id %>" class="list-group-item list-group-item-action">
                                        <div class="d-flex w-100 justify-content-between">
                                            <h6 class="mb-1"><%= dk.khoaHoc.tenKhoaHoc %></h6>
                                            <% 
                                                let badgeClass = 'bg-secondary';
                                                if (dk.khoaHoc.trangThaiThucTe === 'Đang diễn ra') badgeClass = 'bg-success';
                                                if (dk.khoaHoc.trangThaiThucTe === 'Đã kết thúc') badgeClass = 'bg-danger';
                                            %>
                                            <span class="badge <%= badgeClass %> rounded-pill"><%= dk.khoaHoc.trangThaiThucTe %></span>
                                        </div>
                                        <p class="mb-1 text-muted small">
                                            <i class="bi bi-calendar-check me-1"></i>
                                            Bắt đầu: <%= dk.khoaHoc.thoiGianBatDau ? new Date(dk.khoaHoc.thoiGianBatDau).toLocaleDateString('vi-VN') : 'Chưa xác định' %>
                                        </p>
                                    </a>
                                <% } %>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <p class="text-muted">Bạn chưa đăng ký khóa học nào.</p>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal sửa -->
<div class="modal fade" id="editHocVien" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <form action="/hocvien/profile/update/<%= hv?._id %>" method="POST">
                <div class="modal-header">
                    <h5 class="modal-title">Chỉnh sửa thông tin</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body row g-3">
                    <div class="col-md-6">
                        <label for="hoTen" class="form-label">Họ tên</label>
                        <input type="text" name="hoTen" id="hoTen" class="form-control" value="<%= hv?.hoTen || '' %>" required>
                    </div>
                    <div class="col-md-6">
                        <label for="ngaySinh" class="form-label">Ngày sinh</label>
                        <input type="date" name="ngaySinh" id="ngaySinh" class="form-control"
                            value="<%= hv?.ngaySinh ? new Date(hv.ngaySinh).toISOString().substring(0,10) : '' %>">
                    </div>
                    <div class="col-md-6">
                        <label for="gioiTinh" class="form-label">Giới tính</label>
                        <select name="gioiTinh" id="gioiTinh" class="form-select">
                            <option value="Nam" <%= hv?.gioiTinh === "Nam" ? "selected" : "" %>>Nam</option>
                            <option value="Nữ" <%= hv?.gioiTinh === "Nữ" ? "selected" : "" %>>Nữ</option>
                            <option value="Khác" <%= hv?.gioiTinh === "Khác" ? "selected" : "" %>>Khác</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label for="email" class="form-label">Email</label>
                        <input type="email" name="email" id="email" class="form-control" value="<%= hv?.email || '' %>">
                    </div>
                    <div class="col-md-6">
                        <label for="soDienThoai" class="form-label">Số điện thoại</label>
                        <input type="text" name="soDienThoai" id="soDienThoai" class="form-control" value="<%= hv?.soDienThoai || '' %>">
                    </div>
                    <div class="col-md-6">
                        <label for="soZalo" class="form-label">Số Zalo</label>
                        <input type="text" name="soZalo" id="soZalo" class="form-control" value="<%= hv?.soZalo || '' %>">
                    </div>
                    <div class="col-12">
                        <label for="diaChi" class="form-label">Địa chỉ</label>
                        <input type="text" name="diaChi" id="diaChi" class="form-control" value="<%= hv?.diaChi || '' %>">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-success"><i class="bi bi-check-circle-fill me-1"></i> Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>