
<h3>Chọn khóa học để kiểm tra học viên xin nghỉ</h3>
<ul class="list-group mb-4">
    <% dsKhoaHoc.forEach(kh=> { %>
        <li class="list-group-item d-flex justify-content-between">
            <span>
                <%= kh.tenKhoaHoc %>
            </span>
            <a href="/giangvien/xinnghi/khoa/<%= kh._id %>" class="btn btn-sm btn-primary">Chọn</a>
        </li>
        <% }) %>
</ul>